@{
    ViewData["Title"] = "Library";
}

<div class="hero">
    <div class="shelf" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
    <h1>The University Library</h1>
    <p>A small system for keeping track of the books on the shelf and the people who borrow them.</p>
</div>

<div class="tiles">
    <a asp-controller="Books" asp-action="Index" class="tile">
        <span class="arrow">→</span>
        <div class="tile-title">Books</div>
        <div class="tile-sub">Browse and edit the catalogue</div>
    </a>
    <a asp-controller="Members" asp-action="Index" class="tile">
        <span class="arrow">→</span>
        <div class="tile-title">Members</div>
        <div class="tile-sub">Students, faculty and regulars</div>
    </a>
</div>
