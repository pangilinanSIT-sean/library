@model List<Book>
@{
    ViewData["Title"] = "Books";
}

<div class="page-head">
    <div>
        <h1>Books</h1>
        <p class="sub">@Model.Count books in the catalogue</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add a book</a>
</div>

<div class="ledger-wrap">
    <table class="ledger">
        <thead>
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th class="num">Price</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Title</td>
                    <td><span class="tag tag-@((book.Category ?? "none").ToLower())">@(book.Category ?? "—")</span></td>
                    <td class="num">@(book.Price?.ToString("N2") ?? "—")</td>
                    <td class="actions">
                        <a asp-action="Edit" asp-route-id="@book.BookId" class="action">Edit</a>
                        <a asp-action="Delete" asp-route-id="@book.BookId" class="action action-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
