@model Book
@{
    ViewData["Title"] = "Delete a book";
}

<div class="page-head">
    <div>
        <h1>Delete a book</h1>
        <p class="sub">This cannot be undone.</p>
    </div>
</div>

<div class="panel panel-danger">

    <p>Are you sure you want to delete this book?</p>
    <dl class="facts">
        <dt>Title</dt>
        <dd>@Model.Title</dd>
        <dt>Category</dt>
        <dd>@(Model.Category ?? "—")</dd>
        <dt>Price</dt>
        <dd>@(Model.Price?.ToString("N2") ?? "—")</dd>
    </dl>
    <p class="note">Any loans of this book are deleted with it.</p>

    <form asp-action="Delete" asp-route-id="@Model.BookId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>
