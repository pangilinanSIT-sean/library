@model List<Note>
@{
    ViewData["Title"] = "Notes";
}

<div class="page-head">
    <div>
        <h1>Notes</h1>
        <p class="sub">@Model.Count notes</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add a note</a>
</div>

<div class="ledger-wrap">
    <table class="ledger">
        <thead>
            <tr>
                <th>Title</th>
                <th>Details</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var note in Model)
            {
                <tr>
                    <td>@note.Title</td>
                    <td title="@note.Body" style="max-width:20rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--muted)">@(note.Body ?? "—")</td>
                    <td style="white-space:nowrap">@note.CreatedOn.ToString("MMM d, yyyy")</td>
                    <td class="actions">
                        <a asp-action="Edit" asp-route-id="@note.NoteId" class="action">Edit</a>
                        <a asp-action="Delete" asp-route-id="@note.NoteId" class="action action-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
