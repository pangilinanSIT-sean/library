@model Member
@{
    ViewData["Title"] = "Edit a member";
}

<div class="page-head">
    <div>
        <h1>Edit a member</h1>
        <p class="sub">Change anything, then save.</p>
    </div>
</div>

<form asp-action="Edit" method="post" class="panel">
    <input type="hidden" asp-for="MemberId" />

    <div class="mb-3">
        <label asp-for="FullName" class="form-label">Full name</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="MemberType" class="form-label">Type</label>
        <select asp-for="MemberType" class="form-select">
            <option>Regular</option>
            <option>Student</option>
            <option>Faculty</option>
        </select>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
