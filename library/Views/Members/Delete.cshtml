@model Member
@{
    ViewData["Title"] = "Delete a member";
}

<div class="page-head">
    <div>
        <h1>Delete a member</h1>
        <p class="sub">This cannot be undone.</p>
    </div>
</div>

<div class="panel panel-danger">

    <p>Are you sure you want to delete this member?</p>
    <dl class="facts">
        <dt>Name</dt>
        <dd>@Model.FullName</dd>
        <dt>Email</dt>
        <dd>@(Model.Email ?? "—")</dd>
        <dt>Type</dt>
        <dd>@Model.MemberType</dd>
    </dl>
    <p class="note">A member who has loans cannot be deleted.</p>

    <form asp-action="Delete" asp-route-id="@Model.MemberId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>
